# Load it with:  bash artix-install.sh --preset <this file, an https link or a name>
# Disk, passwords and users are never stored here; the installer asks for them.
INIT=dinit
FS=zfs
ENC=luks2
GRUB_BOOT=encrypted
BOOTLOADER=zfsbootmenu
SECUREBOOT=0
SNAPPER=1
SWAP=zram
SWAP_SIZE=4
KERNELS=linux-lts
MIRROR=auto
ARCH_REPOS=0
HOST_NAME=artix
KEYMAP=us
LOCALE=en_US.UTF-8
TIMEZONE=UTC
NET=nm
DESKTOP=plasma
DM=sddm
DOTS=
GPU=auto
APPS=firefox vlc libreoffice flatpak git
GAMING=
PERIPH=
EXTRA_PKGS=
AUR_HELPER=yay
AUR_PKGS=
BS_PROGS=
BS_DOTFILES=
BS_BRANCH=
BS_SHELL=bash
BS_POWER=0
