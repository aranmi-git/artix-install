# artix-install preset v1
# name: i3-s6
# id: i3-s6@1f6d8a729f4daa19
# Made by artix-install.sh 1.0 on 2026-11-18.
# Load it with:  bash artix-install.sh --preset <this file, an https link or a name>
# Disk, passwords and users are never stored here; the installer asks for them.
INIT=s6
FS=btrfs
ENC=luks2
GRUB_BOOT=encrypted
BOOTLOADER=grub
SECUREBOOT=0
SNAPPER=1
SWAP=zram
SWAP_SIZE=4
KERNELS=linux linux-lts
MIRROR=auto
ARCH_REPOS=0
HOST_NAME=artix
KEYMAP=us
LOCALE=en_US.UTF-8
TIMEZONE=UTC
NET=nm
DESKTOP=i3
DM=auto
DOTS=cachyos-i3
GPU=auto
APPS=firefox git
GAMING=
PERIPH=
EXTRA_PKGS=
AUR_HELPER=paru
AUR_PKGS=
BS_PROGS=
BS_DOTFILES=
BS_BRANCH=
BS_SHELL=bash
BS_POWER=0
